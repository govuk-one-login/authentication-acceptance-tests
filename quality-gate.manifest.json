{
  "$schema": "https://raw.githubusercontent.com/govuk-one-login/quality-gates/refs/tags/v0.13.0/schemas/schema.json",
  "services": [
    {
      "product": "Authentication",
      "component": "authentication-acceptance-tests",
      "promotionType": "securePipelines",
      "checks": [
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-commit.yml",
            "path": "$.jobs.pre-commit"
          }
        },
        {
          "checkTypes": [
            "code style and linting"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.style-checks"
          }
        },
        {
          "checkTypes": [
            "code quality",
            "unit test coverage"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/pre-merge-checks.yml",
            "path": "$.jobs.run-sonar-analysis"
          }
        },
        {
          "checkTypes": [
            "code style and linting",
            "code quality"
          ],
          "phase": "pre-merge",
          "provider": "GitHub",
          "config": {
            "file": ".github/workflows/require-pinned-github-actions.yml",
            "path": "$.jobs.check-actions-sha"
          }
        }
      ]
    }
  ]
}
